[Unit]
Description=Hamster Wheel Tracker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_DIR@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/hamster-wheel-tracker
ExecStart=@VENV_DIR@/bin/hamster-tracker serve
Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
