# Persistent state written by calibration/database code.
HAMSTER_TRACKER_CONFIG=/var/lib/hamster-wheel-tracker/config.json
HAMSTER_TRACKER_DB=/var/lib/hamster-wheel-tracker/tracker.db

# Bind to all interfaces so a phone on the same LAN can reach the dashboard.
HAMSTER_TRACKER_HOST=0.0.0.0
HAMSTER_TRACKER_PORT=8000
HAMSTER_TRACKER_LOG_LEVEL=info
